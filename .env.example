# 시환로그 환경변수 예시
# 1) 이 파일을 복사해서 이름을 .env.local 로 바꾸세요.
# 2) = 뒤에 Supabase 화면(Project Settings → API)의 값을 붙여넣으세요.
# 3) .env.local 은 비밀 파일입니다. 다른 사람에게 보내거나 GitHub에 올리지 마세요.
#
# 둘 다 비워 두면 화면에 '예시 데이터'가 보입니다.
# 이름 앞에 NEXT_PUBLIC_ 을 붙이지 마세요 (서버에서만 읽도록 되어 있습니다).
# service_role 키는 여기에 넣지 마세요 (방문자 화면에는 필요 없습니다).

SUPABASE_URL=
SUPABASE_ANON_KEY=
